# Exclude the legacy static frontend from GitHub's language statistics —
# this repo's subject is the Java backend port, not the pre-existing HTML.
*.html linguist-vendored=true
backend/src/main/resources/seed/seed-data.json linguist-generated=true
# Server skriptləri (bash) mütləq LF olmalıdır — CRLF onları pozur.
deploy/** text eol=lf
# Konteyner giriş skripti (sh) də LF olmalıdır.
backend/docker-entrypoint.sh text eol=lf
